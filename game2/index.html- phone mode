<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Snorlax</title>
<style>
  body { margin:0; background:#222; display:flex; justify-content:center; align-items:center; height:100vh; height:100dvh; font-family:sans-serif; }
  canvas { background:#000; touch-action:none; }
  button { font-size:16px; padding:8px 14px; touch-action:manipulation; }
</style>
</head>
<body>
<div style="text-align:center">
<canvas id="c" width="400" height="400"></canvas><br>
<button onclick="toggleRequested = true">Sleep / Wake</button>
<button onclick="if(confirm('Delete your save and start over?')) resetGame()" style="margin-top:8px">Reset save</button>
</div>
<script>
const canvas = document.getElementById("c");
const ctx = canvas.getContext("2d");

// Fit the 400x400 game to the window; game logic stays in 400x400 coordinates
function resize() {
  const size = Math.max(200, Math.floor(Math.min(window.innerWidth, window.innerHeight - 80)));
  canvas.width = size;
  canvas.height = size;
  ctx.setTransform(size / 400, 0, 0, size / 400, 0, 0);
  ctx.imageSmoothingEnabled = false;
}
window.addEventListener("resize", resize);
resize();

// ---- Sprite system -------------------------------------------------
// All art is embedded below. Any animation missing from EMBEDDED loads from
// assets/<name>.png instead. If a file is missing, a placeholder shape is drawn instead.
const EMBEDDED = {
  snorlaxE: "data:image/png;base64,",
  snorlaxD: "data:image/png;base64,",
  snorlaxC: "data:image/png;base64,",
  snorlaxB: "data:image/png;base64,",
  forest: "data:image/jpeg;base64,",
  food1: "data:image/png;base64,",
  snorlaxA: "data:image/png;base64,"
};
const images = {};
ctx.imageSmoothingEnabled = false;
function loadAnim(name) {
  const img = new Image();
  img.onload = () => { img.ok = true; };
  img.src = EMBEDDED[name] || ("assets/" + name + ".png");
  images[name] = img;
}
["forest","snorlaxA","snorlaxB","snorlaxC","snorlaxD","snorlaxE","food1"].forEach(loadAnim);

const PLACEHOLDER = {
  forest:   { w:400, h:400, color:"#2e7d32", shape:"rect" },
  snorlaxA: { w:300, h:300, color:"#37606b", shape:"ellipse" },
  snorlaxB: { w:300, h:300, color:"#2f7a8a", shape:"ellipse" },
  snorlaxC: { w:300, h:300, color:"#3a8f6a", shape:"ellipse" },
  snorlaxD: { w:300, h:300, color:"#7a5fb0", shape:"ellipse" },
  snorlaxE: { w:300, h:300, color:"#c9a227", shape:"ellipse" },
  food1:    { w:16,  h:16,  color:"#ff8c1a", shape:"circle" }
};

// display size tweaks (1 = as is)
const SNORLAX_SIZE = 2;
const FOOD_SIZE = 0.5;

function createSprite(x, y) {
  return { x, y, scale:1, velocityY:0, visible:true, anim:null,
    setAnimation(n) { this.anim = n; } };
}

function size(s) {
  const img = images[s.anim];
  const p = PLACEHOLDER[s.anim];
  const m = s.anim === "food1" ? FOOD_SIZE : s.anim.startsWith("snorlax") ? SNORLAX_SIZE : 1;
  const w = (img && img.ok ? img.naturalWidth : p.w) * s.scale * m;
  const h = (img && img.ok ? img.naturalHeight : p.h) * s.scale * m;
  return { w, h };
}

function drawSprite(s) {
  if (!s.visible) return;
  const { w, h } = size(s);
  const img = images[s.anim];
  if (img && img.ok) {
    ctx.drawImage(img, s.x - w/2, s.y - h/2, w, h);
    return;
  }
  const p = PLACEHOLDER[s.anim];
  ctx.fillStyle = p.color;
  ctx.beginPath();
  if (p.shape === "rect") ctx.rect(s.x - w/2, s.y - h/2, w, h);
  else if (p.shape === "ellipse") ctx.ellipse(s.x, s.y, w/2, h/2, 0, 0, Math.PI*2);
  else ctx.arc(s.x, s.y, w/2, 0, Math.PI*2);
  ctx.fill();
}

function randomNumber(a, b) { return Math.floor(Math.random() * (b - a + 1)) + a; }

// ---- Input ---------------------------------------------------------
const mouse = { x:0, y:0, pressed:false };
let toggleRequested = false; // set by space key or the Sleep / Wake button

canvas.addEventListener("pointermove", e => {
  const r = canvas.getBoundingClientRect();
  mouse.x = (e.clientX - r.left) * 400 / r.width; mouse.y = (e.clientY - r.top) * 400 / r.height;
});
canvas.addEventListener("pointerdown", e => {
  const r = canvas.getBoundingClientRect();
  mouse.x = (e.clientX - r.left) * 400 / r.width; mouse.y = (e.clientY - r.top) * 400 / r.height;
  mouse.pressed = true;
});
window.addEventListener("keydown", e => {
  if (e.code === "Space") { e.preventDefault(); if (!e.repeat) toggleRequested = true; }
});
window.addEventListener("keyup", e => {
});

function mousePressedOver(s) {
  if (!mouse.pressed || !s.visible) return false;
  const { w, h } = size(s);
  return Math.abs(mouse.x - s.x) <= w/2 && Math.abs(mouse.y - s.y) <= h/2;
}

// ---- Game state ----------------------------------------------------
let sleep_score = 0;
const forest = createSprite(200, 200);
forest.setAnimation("forest");
forest.scale = 1.5;
const snorlax = createSprite(200, 200);
snorlax.setAnimation("snorlaxA");
snorlax.scale = .3;
snorlax.velocityY = -1;
const food1 = createSprite(randomNumber(0,400), randomNumber(0,400));
food1.setAnimation("food1");
food1.scale = 2;
let isFollowing = false;
let timer = 0;
let timerActive = false;
let isSleeping = false;
let sleepTimer = 0;

// ---- Save / load ---------------------------------------------------
const FPS = 30;
const FRAMES_PER_POINT = 108000; // 1 hour of sleep = 1 point
let lastTime = Date.now();
const SAVE_KEY = "snorlax_save_v1";

function applyStage() {
  if (sleep_score >= 1500)     { snorlax.setAnimation("snorlaxE"); snorlax.scale = .5; }
  else if (sleep_score >= 1000){ snorlax.setAnimation("snorlaxD"); snorlax.scale = .5; }
  else if (sleep_score >= 500) { snorlax.setAnimation("snorlaxC"); snorlax.scale = .5; }
  else if (sleep_score >= 25)  { snorlax.setAnimation("snorlaxB"); snorlax.scale = .6; }
}

let noSave = false;
function saveGame() {
  if (noSave) return;
  try {
    localStorage.setItem(SAVE_KEY, JSON.stringify({
      sleep_score, sleepTimer, isSleeping, timer, timerActive, savedAt: Date.now(),
      foodVisible: food1.visible, foodX: food1.x, foodY: food1.y
    }));
  } catch (e) {}
}

function loadGame() {
  try {
    const d = JSON.parse(localStorage.getItem(SAVE_KEY));
    if (!d) return;
    sleep_score = d.sleep_score || 0;
    sleepTimer = d.sleepTimer || 0;
    isSleeping = !!d.isSleeping;
    timer = d.timer || 0;
    timerActive = !!d.timerActive;
    food1.visible = d.foodVisible !== false;
    food1.x = d.foodX ?? food1.x;
    food1.y = d.foodY ?? food1.y;
    if (isSleeping) {
      snorlax.velocityY = 0;
      if (d.savedAt) sleepTimer += (Date.now() - d.savedAt) * FPS / 1000; // counts time while closed
    }
  } catch (e) {}
}

function resetGame() {
  noSave = true;
  try { localStorage.removeItem(SAVE_KEY); } catch (e) {}
  location.reload();
}

loadGame();
applyStage();
window.addEventListener("beforeunload", saveGame);
document.addEventListener("visibilitychange", () => { if (document.hidden) saveGame(); });

function draw() {
  if (snorlax.y < 198) snorlax.velocityY = .3;
  if (snorlax.y > 202) snorlax.velocityY = -.3;

  if (!isSleeping && mousePressedOver(food1)) isFollowing = true;

  // drawSprites + text
  drawSprite(forest);
  drawSprite(snorlax);
  if (!isSleeping) drawSprite(food1); // no food while sleeping
  ctx.fillStyle = "blue";
  ctx.font = "20px sans-serif";
  ctx.fillText("sleep score: " + sleep_score, 100, 100);

  if (isSleeping) {
    const left = Math.ceil((FRAMES_PER_POINT - sleepTimer) / FPS);
    const m = Math.floor(left / 60), sec = String(left % 60).padStart(2, "0");
    ctx.fillStyle = "blue";
    ctx.font = "16px sans-serif";
    ctx.textAlign = "center";
    ctx.fillText("sleeping... +1 in " + m + ":" + sec, 200, 385);
    ctx.textAlign = "left";
  }

  if (isFollowing && !isSleeping) {
    food1.x = mouse.x;
    food1.y = mouse.y;
    if (mousePressedOver(snorlax)) {
      sleep_score += 1;
      food1.visible = false;
      isFollowing = false;
      food1.x = randomNumber(0,400);
      food1.y = randomNumber(0,400);
      timerActive = true;
    }
  }
  if (timerActive) timer += 1;
  if (timer > randomNumber(1000,19999)) {
    food1.visible = true;
    timer = 0;
  }
  applyStage();

  // space toggles sleep (once per key press)
  if (toggleRequested) {
    toggleRequested = false;
    if (isSleeping) {
      isSleeping = false;
      snorlax.velocityY = -1;
    } else {
      isSleeping = true;
      isFollowing = false;
      snorlax.velocityY = 0;
      sleepTimer = 0;
    }
  }

  const now = Date.now();
  const dt = now - lastTime;
  lastTime = now;
  if (isSleeping) sleepTimer += dt * FPS / 1000; // real time, even if tab is in background
  while (sleepTimer >= FRAMES_PER_POINT) {
    sleep_score += 1;
    sleepTimer -= FRAMES_PER_POINT;
  }
  if (isSleeping) snorlax.velocityY = 0;


  // physics step
  snorlax.y += snorlax.velocityY;
  mouse.pressed = false;
}

// code.org runs draw() at 30 fps; keep that so the timers match
setInterval(() => { ctx.clearRect(0, 0, 400, 400); draw(); }, 1000 / 30);
setInterval(saveGame, 2000); // autosave
</script>
</body>
</html>
